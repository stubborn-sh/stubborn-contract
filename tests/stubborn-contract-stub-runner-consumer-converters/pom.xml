<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>sh.stubborn</groupId>
		<artifactId>stubborn-contract-tests</artifactId>
		<version>0.1.0-SNAPSHOT</version>
		<relativePath>..</relativePath>
	</parent>
	<artifactId>stubborn-contract-stub-runner-consumer-converters</artifactId>
	<packaging>jar</packaging>
	<name>Stubborn Contract Stub Runner Consumer Converters</name>
	<description>Proves out-of-the-box JSON conversion for typed messaging consumer contract tests
		(no hand-configured Kafka deserializer / Rabbit converter)</description>
	<dependencies>
		<dependency>
			<groupId>sh.stubborn</groupId>
			<artifactId>stubborn-contract-stub-runner</artifactId>
		</dependency>
		<dependency>
			<groupId>sh.stubborn</groupId>
			<artifactId>stubborn-contract-starter-stub-runner-jetty</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Kafka transport: brings spring-kafka and Boot's Kafka autoconfig. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-kafka</artifactId>
		</dependency>
		<dependency>
			<!-- Spring-free Kafka MessageVerifier building block used by
			     ContractVerifierKafkaConfiguration; optional in verifier-spring-boot. -->
			<groupId>sh.stubborn</groupId>
			<artifactId>stubborn-contract-messaging-kafka</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Rabbit transport: brings spring-rabbit and Boot's Rabbit autoconfig. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-json</artifactId>
		</dependency>
		<dependency>
			<!-- Spring-free RabbitMQ MessageVerifier building block used by
			     ContractVerifierRabbitConfiguration; optional in verifier-spring-boot. -->
			<groupId>sh.stubborn</groupId>
			<artifactId>stubborn-contract-messaging-rabbit</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Testcontainers brokers. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-kafka</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>rabbitmq</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.awaitility</groupId>
			<artifactId>awaitility</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>sh.stubborn</groupId>
			<artifactId>stubborn-contract-tests-support</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
