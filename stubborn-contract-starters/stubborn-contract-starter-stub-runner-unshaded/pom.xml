<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>sh.stubborn</groupId>
		<artifactId>stubborn-contract-starters</artifactId>
		<version>0.1.4-SNAPSHOT</version>
		<relativePath>..</relativePath>
	</parent>
	<artifactId>stubborn-contract-starter-stub-runner-unshaded</artifactId>
	<packaging>jar</packaging>
	<name>Stubborn Contract Stub Runner Starter Unshaded</name>
	<description>Stub runner starter on the ordinary org.wiremock:wiremock + wiremock-jetty12
		pair, with WireMock's Jetty on the application classpath.
	</description>

	<!--
	  WHEN TO USE THIS INSTEAD OF THE DEFAULT

	  stubborn-contract-starter-stub-runner runs the stub server on WireMock's shaded
	  standalone build, because on Spring Boot 4.1 the unshaded one does not work:
	  spring-boot-dependencies version-manages every org.eclipse.jetty:* artifact to 12.1.x,
	  including the jetty-ee10 jars wiremock-jetty12 brings, and the stub server dies on
	  `NoSuchMethodError: org.eclipse.jetty.util.component.Environment.ensure(String)`.

	  This starter is the way back to the unshaded pair. It is the right choice when:
	    * you are not on Spring Boot 4.1 (Boot 3.x manages Jetty at 12.0.x, where
	      wiremock-jetty12 is correct), or
	    * you manage org.eclipse.jetty:* yourself at 12.0.x and want one Jetty in the JVM, or
	    * you extend WireMock through its Jetty internals, which relocation hides, or
	    * the ~19.5 MB shaded jar — which also relocates Jackson and Guava — is a problem for
	      you.

	  On Boot 4.1 with no Jetty management of your own, this starter WILL fail at runtime.
	  That is not a bug in this artifact; it is the upstream incompatibility it declines to
	  work around.
	-->
	<dependencies>
		<dependency>
			<groupId>sh.stubborn</groupId>
			<artifactId>stubborn-contract-stub-runner-spring-boot</artifactId>
		</dependency>
		<dependency>
			<groupId>sh.stubborn</groupId>
			<artifactId>stubborn-contract-wiremock</artifactId>
		</dependency>
		<dependency>
			<groupId>org.wiremock</groupId>
			<artifactId>wiremock</artifactId>
		</dependency>
		<dependency>
			<groupId>org.wiremock</groupId>
			<artifactId>wiremock-jetty12</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<failIfNoTests>false</failIfNoTests>
				</configuration>
			</plugin>
			<!--
			  The mirror image of the default starter's guard: the shaded jar must not appear
			  alongside the unshaded pair, or every com.github.tomakehurst class exists twice
			  and the classloader decides which stub server you get.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>ban-shaded-wiremock</id>
						<phase>validate</phase>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<bannedDependencies>
									<searchTransitive>true</searchTransitive>
									<excludes>
										<exclude>org.wiremock:wiremock-standalone</exclude>
									</excludes>
									<message>wiremock-standalone must not reach this starter's classpath: it carries its own copy of every com.github.tomakehurst class, so having it alongside org.wiremock:wiremock makes which stub server you get a classloader accident. Use stubborn-contract-starter-stub-runner if you want the shaded build.</message>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
