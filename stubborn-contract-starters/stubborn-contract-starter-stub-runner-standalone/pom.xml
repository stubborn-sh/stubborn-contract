<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>sh.stubborn</groupId>
		<artifactId>stubborn-contract-starters</artifactId>
		<version>0.1.4-SNAPSHOT</version>
		<relativePath>..</relativePath>
	</parent>
	<artifactId>stubborn-contract-starter-stub-runner-standalone</artifactId>
	<packaging>jar</packaging>
	<name>Stubborn Contract Stub Runner Starter Standalone</name>
	<description>Explicitly-named alias of stubborn-contract-starter-stub-runner, which now runs
		the stub server on WireMock's shaded standalone build by default.
	</description>

	<!--
	  WHY THIS STARTER IS NOW AN ALIAS
	  It was introduced as the opt-in escape from the split Jetty classpath that Spring Boot 4.1
	  creates for wiremock-jetty12 (jetty-ee10 against Jetty core 12.1). Making that the opt-in
	  turned out to be the wrong default: the ordinary starter then failed out of the box on
	  Boot 4.1 — our own consumer samples proved it — so the shaded build became the default and
	  stubborn-contract-starter-stub-runner is the shaded one.
	  This artifact is kept because the name says plainly which WireMock build you get, and it
	  costs nothing to keep: it is the default starter under a more explicit name. The reverse
	  option is stubborn-contract-starter-stub-runner-unshaded.
	-->
	<dependencies>
		<dependency>
			<groupId>sh.stubborn</groupId>
			<artifactId>stubborn-contract-starter-stub-runner</artifactId>
		</dependency>
	</dependencies>

</project>
