<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>sh.stubborn</groupId>
		<artifactId>stubborn-contract-starters</artifactId>
		<version>0.1.4-SNAPSHOT</version>
		<relativePath>..</relativePath>
	</parent>
	<artifactId>stubborn-contract-starter-stub-runner-jetty</artifactId>
	<packaging>jar</packaging>
	<name>Stubborn Contract Stub Runner Starter Jetty</name>
	<description>Stubborn Contract Stub Runner Jetty runs wiremock stubs with "native" jetty,
		on WireMock's shaded standalone build so the stub server's Jetty is isolated from the
		application's.
	</description>

	<!--
	  REPURPOSED — this starter used to pin jetty-ee10 12.0.39 directly.

	  That pin was what made it unusable in exactly the situation it was meant for. Spring
	  Boot 4.1 aligns Jetty core to 12.1.x and imports jetty-ee11-bom; ee10 12.0.x loaded
	  beside core 12.1.x and the stub server died with

	      java.lang.NoSuchMethodError:
	      org.eclipse.jetty.util.component.Environment.ensure(java.lang.String)

	  and the old warning — "don't use this in a Spring Boot app with its own embedded
	  container" — was really a symptom of sharing one Jetty between the application and
	  the stub server. See stubborn-sh/stubborn#142.

	  It now builds on stubborn-contract-starter-stub-runner-standalone, whose shaded
	  WireMock keeps its Jetty relocated under wiremock.org.eclipse.jetty. Nothing is
	  shared, so there is no version to pin and no container to avoid: this starter is
	  safe alongside an embedded Tomcat or Jetty. See that starter for the trade-offs
	  (~19.5 MB, Jackson and Guava relocated too).
	-->
	<dependencies>
		<!--
		  The shaded stub server replaces the hardcoded jetty-ee10 pins. Servlet support
		  comes from inside the shaded jar, so nothing needs to be aligned with whatever
		  Jetty the application is on.
		-->
		<dependency>
			<groupId>sh.stubborn</groupId>
			<artifactId>stubborn-contract-starter-stub-runner-standalone</artifactId>
			<exclusions>
				<!--
				  Kept from the original starter: this one does not bring a servlet stack of
				  its own, so an application that wants no embedded container does not get
				  one. The shaded stub server needs nothing from spring-boot-starter-web.
				-->
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-web</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<!--
			  Guards the one way this starter can be silently broken: if org.wiremock:wiremock
			  or wiremock-jetty12 comes back through another path, every
			  com.github.tomakehurst class exists twice (once shaded, once not) and whichever
			  the classloader picks decides whether the stub server works — a far harder
			  failure to read than the NoSuchMethodError this starter exists to avoid. Banning
			  the cause is better than detecting the symptom: banDuplicateClasses was tried
			  first and is unusable here, because wiremock-standalone bundles jspecify
			  unrelocated and this project uses jspecify throughout, so it fired on every
			  build for reasons that had nothing to do with WireMock.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>ban-unshaded-wiremock</id>
						<phase>validate</phase>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<bannedDependencies>
									<searchTransitive>true</searchTransitive>
									<excludes>
										<exclude>org.wiremock:wiremock</exclude>
										<exclude>org.wiremock:wiremock-jetty12</exclude>
									</excludes>
									<message>The unshaded WireMock must not reach this starter's classpath: it would duplicate every com.github.tomakehurst class that wiremock-standalone already carries, and put Jetty back on the application's classpath. If you want the unshaded stub server, use stubborn-contract-starter-stub-runner instead.</message>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<failIfNoTests>false</failIfNoTests>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
