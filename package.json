{
  "name": "stubborn-contract-docs",
  "private": true,
  "scripts": {
    "docs:gen": "node docs/.vitepress/reference-gen.mjs",
    "docs:gen:check": "node docs/.vitepress/reference-gen.mjs && git diff --exit-code docs/reference/_generated",
    "docs:check": "node docs/.vitepress/check-docs.mjs",
    "docs:dev": "npm run docs:gen && vitepress dev docs",
    "docs:build": "npm run docs:gen && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run"
  },
  "devDependencies": {
    "mermaid": "^11.16.0",
    "vitepress": "^1.6.3",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^2.1.9"
  },
  "type": "module"
}
