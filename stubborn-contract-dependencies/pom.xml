<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>sh.stubborn</groupId>
		<artifactId>stubborn-contract-build</artifactId>
		<version>0.1.4-SNAPSHOT</version>
		<relativePath>../stubborn-contract-build/pom.xml</relativePath>
	</parent>
	<groupId>sh.stubborn</groupId>
	<artifactId>stubborn-contract-dependencies</artifactId>
	<version>0.1.4-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>stubborn-contract-dependencies</name>
	<description>Stubborn Contract Dependencies</description>
	<properties>
		<wiremock.version>3.13.2</wiremock.version>
		<rest-assured.version>6.2.0</rest-assured.version>
		<spring-cloud-stream.version>5.0.3</spring-cloud-stream.version>
	</properties>
	<!--
	  SCOPE OF THIS BOM — deliberately narrow.

	  This BOM manages Stubborn Contract's own artifacts, plus the few third-party
	  libraries that are part of its API surface and that Spring Boot does not manage
	  (WireMock, REST Assured). It manages nothing else, and in particular it does NOT
	  pin anything Spring Boot already manages.

	  It used to. Jetty, Netty, Tomcat, httpclient5/httpcore5, Zookeeper, icu4j and
	  plexus-utils were pinned here to carry CVE fixes through to consumers. That was
	  the wrong place for them, and it broke real applications (gh-142): a consumer
	  importing this BOM ahead of spring-boot-dependencies had Boot's versions silently
	  replaced by ours. With Boot 4.1 that downgraded Jetty from 12.1.x to 12.0.x and a
	  spring-boot-starter-jetty app failed to start with a NoSuchMethodError. The same
	  mechanism would downgrade any library the moment Boot shipped a newer patch than
	  our pin — so the pins did not just risk breaking apps, they were guaranteed to go
	  stale and start doing so.

	  A BOM that overrides the versions of a framework it integrates with is making a
	  decision that belongs to the application. Boot's versions win; a consumer who needs
	  a different one pins it themselves, in their own build, where they can see it.

	  Those CVE pins still exist for OUR build — in the reactor root pom and
	  stubborn-contract-build/pom.xml, which is where a decision about what we compile
	  and test against belongs. The OWASP gate is unaffected by this file.

	  So: do not add a third-party entry here to fix a CVE. Pin it in the build parent
	  instead. The only reason to add one is that a Stubborn artifact will not work
	  without that exact version and Boot does not manage it.
	-->
	<dependencyManagement>
		<dependencies>
			<!--
			  Stubborn Contract's own artifacts. Pin this BOM once and every module lines up.
			-->
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-wiremock</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-wiremock-spring</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-wiremock-spring-boot</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-migration</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-spec</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-spec-java</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-spec-groovy</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-spec-kotlin</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-verifier</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-generator</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-verifier-spring</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-verifier-spring-boot</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-verifier-spring-cloud</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-messaging-kafka</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-messaging-rabbit</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-messaging-jms</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-messaging-tck</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-converters</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-stub-runner</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-stub-runner-spring-boot</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-stub-runner-spring-cloud</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-stub-runner-quarkus</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-stub-runner-messaging-quarkus</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-starter-verifier</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-starter-stub-runner</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-starter-stub-runner-standalone</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-starter-stub-runner-unshaded</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-starter-stub-runner-jetty</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-maven-plugin</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-gradle-plugin</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-jsonassert</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-xmlassert</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!--
			  Third-party libraries that are part of this project's own API surface and that
			  Spring Boot does NOT manage. These are the only non-Stubborn versions this BOM
			  sets, and they are here because a consumer cannot get a working setup without
			  them: the stub runner is built against WireMock's API, and the generated tests
			  are built against REST Assured's.

			  Everything Spring Boot manages is deliberately absent — see the comment above
			  <dependencyManagement>.
			-->
			<dependency>
				<groupId>org.wiremock</groupId>
				<artifactId>wiremock</artifactId>
				<version>${wiremock.version}</version>
			</dependency>
			<dependency>
				<groupId>org.wiremock</groupId>
				<artifactId>wiremock-jetty12</artifactId>
				<version>${wiremock.version}</version>
			</dependency>
			<dependency>
				<groupId>org.wiremock</groupId>
				<artifactId>wiremock-standalone</artifactId>
				<version>${wiremock.version}</version>
			</dependency>
			<dependency>
				<groupId>io.rest-assured</groupId>
				<artifactId>rest-assured</artifactId>
				<version>${rest-assured.version}</version>
				<scope>test</scope>
			</dependency>
			<!--
			  Spring Cloud Stream is NOT managed by spring-boot-dependencies — Spring Cloud ships
			  its own release train — so a consumer who declares spring-cloud-stream alongside
			  stubborn-contract-verifier-spring-cloud gets no version at all unless this BOM
			  supplies one. It was dropped here when the BOM was narrowed, which broke the
			  stream sample outright; it belongs in the "libraries Boot does not manage" set
			  that this BOM exists to cover.
			-->
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-stream</artifactId>
				<version>${spring-cloud-stream.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-stream-test-binder</artifactId>
				<version>${spring-cloud-stream.version}</version>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<profiles>
		<profile>
			<id>spring</id>
			<repositories>
				<repository>
					<id>spring-snapshots</id>
					<name>Spring Snapshots</name>
					<url>https://repo.spring.io/snapshot</url>
					<snapshots>
						<enabled>true</enabled>
					</snapshots>
					<releases>
						<enabled>false</enabled>
					</releases>
				</repository>
			</repositories>
			<pluginRepositories>
				<pluginRepository>
					<id>spring-snapshots</id>
					<name>Spring Snapshots</name>
					<url>https://repo.spring.io/snapshot</url>
					<snapshots>
						<enabled>true</enabled>
					</snapshots>
					<releases>
						<enabled>false</enabled>
					</releases>
				</pluginRepository>
			</pluginRepositories>
		</profile>
	</profiles>
	<build>
		<plugins>
			<plugin>
				<groupId>org.jetbrains.dokka</groupId>
				<artifactId>dokka-maven-plugin</artifactId>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<configuration>
					<updatePomFile>true</updatePomFile>
					<flattenMode>bom</flattenMode>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
