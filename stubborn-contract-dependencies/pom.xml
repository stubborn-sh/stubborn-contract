	<dependencyManagement>
		<dependencies>
			<!--
			  Security override: import netty-bom at the patched ${netty.version} (4.2.16.Final) so
			  consumers importing this BOM get every io.netty artifact off the vulnerable 4.2.15.Final
			  managed by the Spring Boot 4.1 BOM (netty:netty CVE-2026-56820, -55851, -56745, -56817,
			  -56819, -44891, -55833, -55831, -56816). As with the Jetty pins below, this relies on
			  consumers importing stubborn-contract-dependencies ahead of spring-boot-dependencies.
			  Remove once the Spring Boot BOM ships >= 4.2.16.Final.
			-->
			<dependency>
				<groupId>io.netty</groupId>
				<artifactId>netty-bom</artifactId>
				<version>${netty.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!--
			  Security override: pin every Tomcat artifact the Spring Boot 4.1 BOM manages up to the
			  patched ${tomcat.version} (11.0.24), off the vulnerable 11.0.22 (CVE-2026-55276,
			  -53434, -59083, -59084, -53404). As with the Jetty pins below, this relies on consumers
			  importing stubborn-contract-dependencies ahead of spring-boot-dependencies. Tomcat has
			  no published BOM, so each managed artifact is pinned explicitly. Remove once the Spring
			  Boot BOM ships >= 11.0.24.
			-->
			<dependency>
				<groupId>org.apache.tomcat.embed</groupId>
				<artifactId>tomcat-embed-core</artifactId>
				<version>${tomcat.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.tomcat.embed</groupId>
				<artifactId>tomcat-embed-el</artifactId>
				<version>${tomcat.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.tomcat.embed</groupId>
				<artifactId>tomcat-embed-jasper</artifactId>
				<version>${tomcat.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.tomcat.embed</groupId>
				<artifactId>tomcat-embed-websocket</artifactId>
				<version>${tomcat.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.tomcat</groupId>
				<artifactId>tomcat-annotations-api</artifactId>
				<version>${tomcat.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.tomcat</groupId>
				<artifactId>tomcat-jdbc</artifactId>
				<version>${tomcat.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.tomcat</groupId>
				<artifactId>tomcat-jsp-api</artifactId>
				<version>${tomcat.version}</version>
			</dependency>
			<!--
			  Security override: pin Zookeeper up to the patched ${zookeeper.version} (3.9.5), off the
			  vulnerable 3.9.3 managed by the spring-cloud-zookeeper-dependencies BOM (CVE-2026-24281,
			  CVE-2026-24308). Relies on consumers importing stubborn-contract-dependencies ahead of
			  the spring-cloud BOMs. zookeeper and zookeeper-jute are versioned together. Remove once
			  spring-cloud-zookeeper ships >= 3.9.4.
			-->
			<dependency>
				<groupId>org.apache.zookeeper</groupId>
				<artifactId>zookeeper</artifactId>
				<version>${zookeeper.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.zookeeper</groupId>
				<artifactId>zookeeper-jute</artifactId>
				<version>${zookeeper.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-wiremock</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-wiremock-spring</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-wiremock-spring-boot</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-migration</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-spec</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-spec-java</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-spec-groovy</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-spec-kotlin</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-verifier</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-generator</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-verifier-spring</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-verifier-spring-boot</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-verifier-spring-cloud</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-messaging-kafka</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-messaging-rabbit</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-messaging-jms</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-messaging-tck</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-converters</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-stub-runner</artifactId>
				<version>${project.version}</version>
			</dependency>
			<!--
			  stubborn-contract-stub-runner-app is intentionally NOT managed here. It is a
			  repackaged Spring Boot executable (fat) jar that is deliberately excluded from
			  Maven Central publishing (see central-publishing excludeArtifacts in the root
			  pom). Consumers build it from source (./mvnw package -pl
			  stubborn-contract-stub-runner-app) or use the Docker image — they do not depend
			  on it as a library. Listing it in the BOM would advertise an unresolvable
			  coordinate. See docs/reference/stub-runner-spring-boot.md.
			-->
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-stub-runner-spring-boot</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-stub-runner-spring-cloud</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-stub-runner-quarkus</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-stub-runner-messaging-quarkus</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-starter-verifier</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-starter-stub-runner</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-starter-stub-runner-jetty</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-maven-plugin</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-gradle-plugin</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.wiremock</groupId>
				<artifactId>wiremock</artifactId>
				<version>${wiremock.version}</version>
			</dependency>
			<dependency>
				<groupId>org.wiremock</groupId>
				<artifactId>wiremock-jetty12</artifactId>
				<version>${wiremock.version}</version>
			</dependency>
			<dependency>
				<groupId>org.wiremock</groupId>
				<artifactId>wiremock-standalone</artifactId>
				<version>${wiremock.version}</version>
			</dependency>
			<!--
			  Security override: httpcore5 5.4.2 (via Apache HttpClient5 / WireMock) carries
			  CVE-2026-54399 and CVE-2026-54428 (both CVSS 7.5). Pin the patched 5.4.3 so
			  consumers importing this BOM inherit the fix. Remove once a managing BOM ships >= 5.4.3.
			-->
			<dependency>
				<groupId>org.apache.httpcomponents.core5</groupId>
				<artifactId>httpcore5</artifactId>
				<version>${httpcore5.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.httpcomponents.core5</groupId>
				<artifactId>httpcore5-h2</artifactId>
				<version>${httpcore5.version}</version>
			</dependency>
			<!--
			  Security override: httpclient5 5.6.1 (via Apache HttpClient5 / WireMock) carries
			  CVE-2026-71290 (CVSS 9.1) and is not managed by the Spring Boot BOM. Pin the patched
			  5.6.4 so consumers importing this BOM inherit the fix. Remove once a managing BOM ships >= 5.6.4.
			-->
			<dependency>
				<groupId>org.apache.httpcomponents.client5</groupId>
				<artifactId>httpclient5</artifactId>
				<version>${httpclient5.version}</version>
			</dependency>
			<!--
			  wiremock-jetty12:3.13.2 uses jetty-ee10-*:12.0.37 which calls APIs only present in
			  Jetty 12.0.x (e.g. ByteBufferPool.acquire(int,boolean), Environment.ensure(String)).
			  Spring Boot 4 forces all org.eclipse.jetty:* to 12.1.x where those methods were removed.
			  Pin the Jetty core artifacts to 12.0.37 so consumers who import stubborn-contract-dependencies
			  get Jetty 12.0.x in their own dependencyManagement (which beats the parent BOM).
			-->
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-util</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-io</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-http</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-server</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-security</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-session</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-xml</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-alpn-server</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-alpn-java-server</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-alpn-client</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-alpn-java-client</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-proxy</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-client</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty.http2</groupId>
				<artifactId>jetty-http2-server</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty.http2</groupId>
				<artifactId>jetty-http2-common</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty.http2</groupId>
				<artifactId>jetty-http2-hpack</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<!--
			  wiremock-jetty12:3.13.2 declares the Jakarta EE 10 servlet layer
			  (org.eclipse.jetty.ee10:jetty-ee10-*) and org.eclipse.jetty:jetty-ee at 12.0.30,
			  which the core jetty.version pins above do not reach. Pin them to ${jetty.version}
			  (12.0.37) here as well so consumers importing this BOM get the CVE-patched 12.0.x
			  EE artifacts (CVE-2026-2332, CVE-2026-5795, CVE-2026-1605, CVE-2026-10051).
			-->
			<dependency>
				<groupId>org.eclipse.jetty.ee10</groupId>
				<artifactId>jetty-ee10-servlet</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty.ee10</groupId>
				<artifactId>jetty-ee10-servlets</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty.ee10</groupId>
				<artifactId>jetty-ee10-webapp</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-ee</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-jsonassert</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sh.stubborn</groupId>
				<artifactId>stubborn-contract-xmlassert</artifactId>
				<version>${project.version}</version>
			</dependency>
			<!--
			  CVE-2025-5222 (CVSS 7.0): stubborn-contract-xmlassert pulls icu4j 4.6 transitively via the
			  Eclipse WST xpath2 processor. Pin it here too so consumers importing this BOM get the
			  safe version in their own dependencyManagement (which beats a parent BOM).
			-->
			<dependency>
				<groupId>com.ibm.icu</groupId>
				<artifactId>icu4j</artifactId>
				<version>${icu4j.version}</version>
			</dependency>
			<!--
			  CVE-2025-67030 (CVSS 8.8): stubborn-contract-stub-runner embeds Maven and pulls
			  plexus-utils transitively; the Spring Boot 4.1 BOM downgrades it to the vulnerable
			  3.6.0. Pin the patched 3.6.1 here too so consumers importing this BOM get the safe
			  version in their own dependencyManagement. Remove once a managing BOM ships >= 3.6.1.
			-->
			<dependency>
				<groupId>org.codehaus.plexus</groupId>
				<artifactId>plexus-utils</artifactId>
				<version>${plexus-utils.version}</version>
			</dependency>
			<!-- Spring Boot 4 split modules (needed for RestClient / TestRestTemplate) -->
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-http-client</artifactId>
				<version>${spring-boot.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-restclient</artifactId>
				<version>${spring-boot.version}</version>
			</dependency>
			<!-- Spring Cloud Stream — tested compatible version -->
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-stream</artifactId>
				<version>${spring-cloud-stream.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-stream-test-binder</artifactId>
				<version>${spring-cloud-stream.version}</version>
				<scope>test</scope>
			</dependency>
			<!-- REST-Assured — tested compatible version -->
			<dependency>
				<groupId>io.rest-assured</groupId>
				<artifactId>rest-assured</artifactId>
				<version>${rest-assured.version}</version>
				<scope>test</scope>
			</dependency>
			<!-- ArchUnit for enforcing no-Spring in core modules -->
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit-junit5</artifactId>
				<version>${archunit.version}</version>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<profiles>
		<profile>
			<id>spring</id>
			<repositories>
				<repository>
					<id>spring-snapshots</id>
					<name>Spring Snapshots</name>
					<url>https://repo.spring.io/snapshot</url>
					<snapshots>
						<enabled>true</enabled>
					</snapshots>
					<releases>
						<enabled>false</enabled>
					</releases>
				</repository>
			</repositories>
			<pluginRepositories>
				<pluginRepository>
					<id>spring-snapshots</id>
					<name>Spring Snapshots</name>
					<url>https://repo.spring.io/snapshot</url>
					<snapshots>
						<enabled>true</enabled>
					</snapshots>
					<releases>
						<enabled>false</enabled>
					</releases>
				</pluginRepository>
			</pluginRepositories>
		</profile>
	</profiles>
	<build>
		<plugins>
			<plugin>
				<groupId>org.jetbrains.dokka</groupId>
				<artifactId>dokka-maven-plugin</artifactId>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<configuration>
					<updatePomFile>true</updatePomFile>
					<flattenMode>bom</flattenMode>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
