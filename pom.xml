			</dependency>
			<!--
			  Security override: httpcore5 5.4.2 (pulled transitively via Apache HttpClient5 /
			  WireMock) carries CVE-2026-54399 and CVE-2026-54428 (both CVSS 7.5). Pin to the
			  patched 5.4.3. Remove once the managing BOM ships >= 5.4.3.
			-->
			<dependency>
				<groupId>org.apache.httpcomponents.core5</groupId>
				<artifactId>httpcore5</artifactId>
				<version>${httpcore5.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.httpcomponents.core5</groupId>
				<artifactId>httpcore5-h2</artifactId>
				<version>${httpcore5.version}</version>
			</dependency>
			<!--
			  wiremock-jetty12:3.13.2 uses jetty-ee10-*:12.0.37 which calls APIs only present in
			  Jetty 12.0.x (e.g. ByteBufferPool.acquire(int,boolean), Environment.ensure(String)).
			  Spring Boot 4 imports spring-boot-dependencies which forces all org.eclipse.jetty:* to
			  12.1.x. Direct entries below override the BOM import so WireMock works on test classpath.
			-->
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-util</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-io</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-http</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-server</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-security</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-session</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-xml</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-alpn-server</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-alpn-java-server</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-alpn-client</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-alpn-java-client</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-proxy</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-client</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty.http2</groupId>
				<artifactId>jetty-http2-server</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty.http2</groupId>
				<artifactId>jetty-http2-common</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty.http2</groupId>
				<artifactId>jetty-http2-hpack</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<!--
			  wiremock-jetty12:3.13.2 also pulls the Jakarta EE 10 servlet layer
			  (org.eclipse.jetty.ee10:jetty-ee10-*) and org.eclipse.jetty:jetty-ee, which it
			  declares at 12.0.30 - a version the core jetty.version pins above do NOT reach
			  (different groupId / artifacts). 12.0.30 carries CVE-2026-2332 (9.1), CVE-2026-5795
			  (7.4), CVE-2026-1605 (7.5) and CVE-2026-10051 (6.9). Pin these to ${jetty.version}
			  (12.0.37, same 12.0.x line wiremock-jetty12 requires) so they move off 12.0.30 too.
			-->
			<dependency>
				<groupId>org.eclipse.jetty.ee10</groupId>
				<artifactId>jetty-ee10-servlet</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty.ee10</groupId>
				<artifactId>jetty-ee10-servlets</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty.ee10</groupId>
				<artifactId>jetty-ee10-webapp</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-ee</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<!--
			  CVE-2025-5222 (CVSS 7.0): icu4j 4.6 is a deep transitive of the Eclipse WST xpath2
			  processor used by stubborn-contract-xmlassert. Pin to a current release (also mirrored in the
			  consumer BOM so users of stubborn-contract-xmlassert get the safe version). Only modules that
			  transitively use icu4j are affected, so a reactor-wide pin is safe here.
			-->
			<dependency>
				<groupId>com.ibm.icu</groupId>
				<artifactId>icu4j</artifactId>
				<version>${icu4j.version}</version>
			</dependency>
			<!--
			  CVE-2025-67030 (CVSS 8.8): stubborn-contract-stub-runner embeds Maven (maven-embedder
			  3.9.16) to resolve stubs and pulls plexus-utils transitively. The Spring Boot 4.1 BOM
			  downgrades plexus-utils to the vulnerable 3.6.0; pin the patched 3.6.1 (the version
			  maven-embedder 3.9.16 itself declares). Directly declared here so it beats the imported
			  Boot BOM. Remove once the managing BOM ships >= 3.6.1.
			-->
			<dependency>
				<groupId>org.codehaus.plexus</groupId>
				<artifactId>plexus-utils</artifactId>
				<version>${plexus-utils.version}</version>
			</dependency>
		</dependencies>
