		<!--
		  CVE-2026-27446 (CVSS 9.3) against org.apache.activemq:artemis-* (apache:artemis CPE).
		  The Spring Boot 4.1 BOM imports artemis-bom at 2.53.0 (still in the affected range); the
		  fix ships on the same 2.x line, so pin the latest patched 2.55.0. Realigned reactor-wide by
		  importing org.apache.activemq:artemis-bom:${artemis.version} ahead of spring-boot-dependencies
		  below, so every artemis-* artifact wins over the Boot BOM's 2.53.0. Artemis reaches this
		  build only through the JMS/Artemis test-and-sample harness (tests/samples-messaging-jms,
		  tests/stubborn-contract-stub-runner-jms) — it is NOT shipped in any published runtime
		  artifact — but we bump it anyway since a patched release exists. Remove once the Spring Boot
		  BOM ships artemis >= 2.54.
		-->
		<artemis.version>2.55.0</artemis.version>
		<testcontainers.version>1.21.4</testcontainers.version>
		<hamcrest.version>3.0</hamcrest.version>

		<!-- We need to have compatibility with Gradle -->
		<groovy.version>4.0.28</groovy.version>
		<!-- We need to have compatibility with Boot -->
		<maven.version>3.9.16</maven.version>
		<!-- Resolver has to be aligned with Maven (e.g resolver 1.4 and Maven 3.6 or resolver 1.3 and Maven 3.5) -->
		<maven.resolver.version>1.9.27</maven.resolver.version>
		<xpath2.processor.version>2.1.100</xpath2.processor.version>
		<xerces.version>2.12.2</xerces.version>
		<archunit.version>1.3.0</archunit.version>
		<archunit-junit5.version>1.3.0</archunit-junit5.version>
		<!-- Set to false in Spring-agnostic core modules to ban Spring compile deps -->
		<stubborn.no-spring.skip>true</stubborn.no-spring.skip>
		<commons-beanutils.version>1.11.0</commons-beanutils.version>
		<sisu-inject-plexus.version>2.6.0</sisu-inject-plexus.version>

		<javadoc.failOnError>false</javadoc.failOnError>
		<javadoc.failOnWarnings>false</javadoc.failOnWarnings>
	</properties>

