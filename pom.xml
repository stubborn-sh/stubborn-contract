	<dependencyManagement>
		<dependencies>
			<!--
			  Security override: pull every io.netty artifact up to the patched ${netty.version}
			  (4.2.16.Final). Imported BEFORE spring-boot-dependencies so the netty-bom entries win
			  over the Boot BOM's vulnerable 4.2.15.Final for the whole reactor. See the CVE list on
			  the netty.version property in stubborn-contract-build/pom.xml. Remove once Boot ships >= 4.2.16.
			-->
			<dependency>
				<groupId>io.netty</groupId>
				<artifactId>netty-bom</artifactId>
				<version>${netty.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!--
			  Security override: import artemis-bom at the patched ${artemis.version} (2.55.0)
			  BEFORE spring-boot-dependencies so every org.apache.activemq:artemis-* artifact wins
			  over the Boot BOM's vulnerable 2.53.0 (CVE-2026-27446, CVSS 9.3). See the artemis.version
			  property above. Remove once the Spring Boot BOM ships artemis >= 2.54.
			-->
