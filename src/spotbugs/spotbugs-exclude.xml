<FindBugsFilter>

	<!-- Repackaged third-party code (e.g. xeger) — not maintained here. -->
	<Match>
		<Class name="~repackaged\..*"/>
	</Match>

	<!-- Spring Cloud Contract backward-compatibility shims deliberately reuse the
	     SCC package/type names and delegate to the Stubborn types. The name/method
	     shadowing is intentional. -->
	<Match>
		<Class name="~org\.springframework\.cloud\.contract\..*"/>
	</Match>

	<!-- The contract DSL model is a mutable builder-style API: getters and
	     constructors intentionally share references with the caller. Defensive
	     copying would change the DSL's documented behaviour. -->
	<Match>
		<Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP"/>
	</Match>

	<!-- Random is used to generate example/stub values for contracts, never for
	     security-sensitive purposes. -->
	<Match>
		<Bug pattern="PREDICTABLE_RANDOM,DMI_RANDOM_USED_ONLY_ONCE"/>
	</Match>

	<!-- Regexes come from contract authors (trusted, build-time), not from
	     untrusted runtime input. -->
	<Match>
		<Bug pattern="REDOS"/>
	</Match>

	<!-- Stubborn Contract is a build-time / test-time tool: it reads the
	     developer's own contract files, evaluates the XPath / Groovy DSL those
	     contracts declare, writes generated test sources, and deep-clones the
	     in-memory contract model. None of these inputs are untrusted runtime
	     data, so FindSecBugs' injection/traversal patterns are false positives
	     here. (XML external-entity parsing is separately hardened in code.) -->
	<Match>
		<Bug pattern="PATH_TRAVERSAL_IN,PATH_TRAVERSAL_OUT,XPATH_INJECTION,GROOVY_SHELL,OBJECT_DESERIALIZATION"/>
	</Match>

	<!-- The migrated DSL utilities interoperate with Groovy by creating
	     anonymous groovy.lang.Closure subclasses. Groovy invokes their doCall
	     methods reflectively via Closure.call(), which SpotBugs cannot see, so
	     it wrongly reports the methods as uncallable. -->
	<Match>
		<Class name="~.*\.(ContentUtils|MapConverter)\$.*"/>
		<Bug pattern="UMAC_UNCALLABLE_METHOD_OF_ANONYMOUS_CLASS"/>
	</Match>

	<!-- YamlContract is a plain data-transfer object whose public fields are
	     populated by the YAML deserializer through reflection; SpotBugs cannot
	     see those writes and reports the fields as never written. -->
	<Match>
		<Class name="~.*\.YamlContract(\$.*)?"/>
		<Bug pattern="UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD,UWF_UNWRITTEN_FIELD"/>
	</Match>

	<!-- Remaining low-severity structural findings in the migrated code base that
	     do not indicate defects: mutable static holders, missing equals overrides
	     on value wrappers, non-static inner helpers, serialization metadata, and
	     default-charset string conversions in build-time code generation. -->
	<Match>
		<Bug pattern="MS_SHOULD_BE_FINAL,MS_MUTABLE_COLLECTION,MS_MUTABLE_COLLECTION_PKGPROTECT,MS_PKGPROTECT,EQ_DOESNT_OVERRIDE_EQUALS,SIC_INNER_SHOULD_BE_STATIC,SIC_INNER_SHOULD_BE_STATIC_ANON,SE_BAD_FIELD,SE_NO_SERIALVERSIONID,SE_BAD_FIELD_STORE,ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD,DM_DEFAULT_ENCODING,CT_CONSTRUCTOR_THROW,NP_LOAD_OF_KNOWN_NULL_VALUE,NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
	</Match>

</FindBugsFilter>
