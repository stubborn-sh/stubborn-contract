<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  Standalone build parent for all Stubborn projects.
	  No dependency on spring-cloud-build — all plugin management is explicit here.
	-->

	<groupId>sh.stubborn</groupId>
	<artifactId>stubborn-contract-build</artifactId>
	<version>0.2.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>Stubborn Build</name>
	<description>Build parent for Stubborn projects</description>

	<url>https://github.com/stubborn-sh/stubborn-contract</url>

	<inceptionYear>2024</inceptionYear>

	<organization>
		<name>Stubborn</name>
		<url>https://stubborn.sh/</url>
	</organization>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
		</license>
	</licenses>

	<scm>
		<connection>scm:git:https://github.com/stubborn-sh/stubborn-contract.git</connection>
		<developerConnection>scm:git:git@github.com:stubborn-sh/stubborn-contract.git</developerConnection>
		<url>https://github.com/stubborn-sh/stubborn-contract</url>
		<tag>HEAD</tag>
	</scm>

	<developers>
		<developer>
			<id>marcingrzejszczak</id>
			<name>Marcin Grzejszczak</name>
			<email>hello@stubborn.sh</email>
		</developer>
	</developers>

	<issueManagement>
		<system>GitHub</system>
		<url>https://github.com/stubborn-sh/stubborn-contract/issues</url>
	</issueManagement>

	<ciManagement>
		<system>GitHub Actions</system>
		<url>https://github.com/stubborn-sh/stubborn-contract/actions</url>
	</ciManagement>

	<properties>
		<!-- Java -->
		<java.version>17</java.version>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<maven.compiler.release>${java.version}</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<!-- Kotlin (for stubborn-contract-extras/spec-kotlin) -->
		<kotlin.version>2.4.10</kotlin.version>
		<!-- Test dependencies -->
		<archunit.version>1.4.2</archunit.version>

		<!-- Maven plugin versions -->
		<maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
		<maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
		<maven-source-plugin.version>3.3.1</maven-source-plugin.version>
		<maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
		<maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
		<maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
		<maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
		<maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
		<maven-install-plugin.version>3.1.4</maven-install-plugin.version>
		<maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
		<maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
		<maven-antrun-plugin.version>3.1.0</maven-antrun-plugin.version>
		<flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
		<central-publishing-maven-plugin.version>0.9.0</central-publishing-maven-plugin.version>
		<!--
		  Auto-publish gate for the Central Portal. Default false so releases land in the
		  Portal as *validated/pending* (immutable GA is NOT triggered) for manual inspection
		  before the operator clicks Publish. Set -Dcentral.autoPublish=true to opt into
		  hands-off publishing once the release flow is trusted.
		-->
		<central.autoPublish>false</central.autoPublish>
		<maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
		<cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
		<exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
		<gmavenplus-plugin.version>4.2.1</gmavenplus-plugin.version>
		<jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
		<pitest-maven.version>1.20.3</pitest-maven.version>
		<pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
		<spring-javaformat.version>0.0.47</spring-javaformat.version>
		<maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
		<build-helper-maven-plugin.version>3.2.0</build-helper-maven-plugin.version>
		<kotlin-maven-plugin.version>${kotlin.version}</kotlin-maven-plugin.version>
		<revapi-maven-plugin.version>0.15.0</revapi-maven-plugin.version>
		<revapi-java.version>0.28.1</revapi-java.version>

		<!-- Static analysis + null safety -->
		<spotbugs-maven-plugin.version>4.10.3.0</spotbugs-maven-plugin.version>
		<findsecbugs-plugin.version>1.13.0</findsecbugs-plugin.version>
		<dependency-check-maven.version>12.1.1</dependency-check-maven.version>
		<error-prone.version>2.36.0</error-prone.version>
		<nullaway.version>0.12.7</nullaway.version>
		<jspecify.version>1.0.1</jspecify.version>

		<!--
		  Security-pinned third-party library versions. Defined here (the common build
		  parent) so the reactor pom, the consumer BOM, and every module share one source of
		  truth. Jetty is held on the 12.0.x line that WireMock 3.13.2 requires (12.1.x
		  removed APIs wiremock-jetty12 calls); httpcore5 is pinned above its vulnerable 5.4.2.
		  httpclient5 is pinned above 5.6.1 (CVE-2026-71290, CVSS 9.1) — it leaks in as a
		  transitive of Apache HttpClient5 / WireMock and is not managed by the Spring Boot BOM.
		  icu4j is pinned above CVE-2025-5222 (buffer overflow, fixed from ICU 77 onward); it
		  leaks in as a deep transitive of the Eclipse WST xpath2 processor in stubborn-contract-xmlassert.
		-->
		<jetty.version>12.0.37</jetty.version>
		<httpcore5.version>5.4.3</httpcore5.version>
		<httpclient5.version>5.6.4</httpclient5.version>
		<icu4j.version>78.3</icu4j.version>
		<!--
		  Defined here (the common build parent) rather than the reactor root so the Docker
		  image module (docker/stubborn-contract-docker, whose parent chain resolves up to this
		  build parent) inherits it and can Maven-filter camelVersion into its gradle.properties.
		  Bumped 4.16.0 -> 4.21.0 (latest 4.x) to clear the batch of apache:camel CVEs that
		  dependency-check matches against camel-core / camel-kafka at 4.16.0 (e.g. CVE-2026-46454,
		  CVE-2026-47323, CVE-2026-53913, CVE-2026-48204, ...). Most affect components we do not use
		  (camel-keycloak, camel-cxf, ...) but share the apache:camel CPE, so a version bump off the
		  affected range is the cleanest fix. Camel is optional/opt-in here (see camel-core/-kafka
		  <optional>true</optional> in stubborn-contract-verifier) and our usage is limited to a few
		  stable core APIs (CamelContext, Message, DefaultMessage), so the blast radius is low.
		-->
		<camel.version>4.22.0</camel.version>
		<!--
		  Netty is managed by the Spring Boot 4.1 BOM at 4.2.15.Final, which carries a batch of
		  DoS / OCSP-bypass CVEs matched against the netty:netty CPE (CVE-2026-56820 [9.1],
		  CVE-2026-55851 [8.7], CVE-2026-56745 [8.7], CVE-2026-56817 [8.3], CVE-2026-56819 [7.5],
		  CVE-2026-44891 [7.5], CVE-2026-55833 [7.5], CVE-2026-55831 [7.5], CVE-2026-56816 [7.5]).
		  All are fixed in 4.2.16.Final (same 4.2.x line). Realigned reactor-wide by importing
		  io.netty:netty-bom:${netty.version} ahead of spring-boot-dependencies (see root pom /
		  consumer BOM). Remove once the Spring Boot BOM ships >= 4.2.16.Final.
		-->
		<netty.version>4.2.16.Final</netty.version>
		<!--
		  Tomcat is managed by the Spring Boot 4.1 BOM at 11.0.22, which carries a batch of
		  high-severity CVEs matched against the apache:tomcat CPE (CVE-2026-55276 [9.1],
		  CVE-2026-53434 [9.1], CVE-2026-59083 [9.1], CVE-2026-59084 [9.1], CVE-2026-53404 [7.3]).
		  All are fixed on the same 11.0.x line; pin the latest patched 11.0.24. Realigned
		  reactor-wide by declaring explicit tomcat-embed-* / tomcat-* dependencyManagement entries
		  at ${tomcat.version} ahead of spring-boot-dependencies (see root pom / consumer BOM), since
		  Tomcat has no published BOM to import. Remove once the Spring Boot BOM ships >= 11.0.24.
		-->
		<tomcat.version>11.0.24</tomcat.version>
		<!--
		  Zookeeper is pulled transitively by spring-cloud-starter-zookeeper-discovery (via Curator)
		  and managed by the spring-cloud-zookeeper-dependencies BOM at 3.9.3, which carries
		  CVE-2026-24281 (7.4) and CVE-2026-24308 (7.5). Both are fixed on the same 3.9.x line; pin
		  the latest patched 3.9.5. Realigned by declaring explicit org.apache.zookeeper:zookeeper /
		  zookeeper-jute dependencyManagement entries at ${zookeeper.version} in the security-override
		  section of the root pom (and the consumer BOM), ahead of the spring-cloud BOM imports.
		  Remove once spring-cloud-zookeeper ships >= 3.9.4.
		-->
		<zookeeper.version>3.9.5</zookeeper.version>
		<!--
		  CVE-2025-67030 (CVSS 8.8): Directory Traversal in plexus-utils Expand.extractFile.
		  maven-embedder 3.9.16 (used by stubborn-contract-stub-runner to resolve stubs) pulls
		  plexus-utils transitively; the Spring Boot 4.1 BOM *downgrades* it to the vulnerable
		  3.6.0. Pin the patched 3.6.1 (the version maven-embedder 3.9.16 itself declares, so
		  fully API-compatible with the Maven 3.9 stack). The stubborn-contract-maven-plugin
		  module keeps its own local plexus-utils.version (4.0.x) for its Groovy tooling needs.
		-->
		<plexus-utils.version>3.6.1</plexus-utils.version>

		<!--
		  Quality gates (see docs/quality-gates.md). JaCoCo aggregate line + branch
		  coverage floor (fraction, 0.80 = 80%). The jacoco-check execution is managed
		  here (pluginManagement) and runs wherever the jacoco plugin is active: under
		  the -Psonar profile (root pom) AND in any module that declares jacoco directly
		  (e.g. stubborn-contract-maven-plugin). haltOnFailure therefore stays FALSE by
		  default so a normal `clean install` reports but never fails on non-gate
		  modules; the gate is ENFORCED only by the CI coverage job, which is scoped to
		  the gate modules and passes -Djacoco.haltOnFailure=true on the command line.
		-->
		<jacoco.line.min>0.80</jacoco.line.min>
		<jacoco.branch.min>0.80</jacoco.branch.min>
		<jacoco.haltOnFailure>false</jacoco.haltOnFailure>
		<!--
		  PIT mutation-coverage floor (percent). 0 = warn mode now; raised to 90 once the
		  test backfill lands. Applied per changed core class by the mutation-diff CI gate.
		-->
		<pitest.mutationThreshold>90</pitest.mutationThreshold>

		<!--
		  Core module gate: set to false in Spring-agnostic core modules to ban
		  direct Spring dependencies (org.springframework.*, *.boot, *.cloud).
		-->
		<stubborn.no-spring.skip>true</stubborn.no-spring.skip>
		<!--
		  SCC-API gate: Stubborn Contract must never depend on Spring Cloud Contract
		  (org.springframework.cloud:spring-cloud-contract*). Enforced in every module
		  and scope by the ban-scc-api enforcer rule. Set to true only in a module that
		  genuinely must keep an SCC dependency (e.g. a dedicated compatibility test).
		-->
		<stubborn.no-scc.skip>false</stubborn.no-scc.skip>
		<!-- Set to false in public API modules to enable revapi binary-compat check. -->
		<stubborn.revapi.skip>true</stubborn.revapi.skip>
		<!--
		  Groovy-free production gate: fails the build if any .groovy source is found under
		  src/main. Set to true only in modules that legitimately ship a Groovy DSL.
		-->
		<stubborn.no-groovy.skip>false</stubborn.no-groovy.skip>
		<!--
		  Groovy-transform-free gate: fails the build if any Java main source imports
		  groovy.transform.* (no-op annotations on Java files). Opt in per module by
		  setting this to false.
		-->
		<stubborn.no-groovy-transform.skip>true</stubborn.no-groovy-transform.skip>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.jspecify</groupId>
				<artifactId>jspecify</artifactId>
				<version>${jspecify.version}</version>
			</dependency>
			<dependency>
				<groupId>com.google.errorprone</groupId>
				<artifactId>error_prone_annotations</artifactId>
				<version>${error-prone.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<distributionManagement>
		<snapshotRepository>
			<id>central</id>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
		</snapshotRepository>
		<repository>
			<id>central</id>
			<url>https://central.sonatype.com/</url>
		</repository>
	</distributionManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven-compiler-plugin.version}</version>
					<configuration>
						<release>${java.version}</release>
						<parameters>true</parameters>
						<useIncrementalCompilation>false</useIncrementalCompilation>
						<compilerArgs>
							<arg>-XDcompilePolicy=simple</arg>
							<arg>--should-stop=ifError=FLOW</arg>
							<arg>-Xplugin:ErrorProne -XepExcludedPaths:.*/(generated-sources|generated-test-sources)/.* -Xep:NullAway:ERROR -XepOpt:NullAway:JSpecifyMode=true -XepOpt:NullAway:AnnotatedPackages=sh.stubborn</arg>
						</compilerArgs>
						<annotationProcessorPaths>
							<path>
								<groupId>com.google.errorprone</groupId>
								<artifactId>error_prone_core</artifactId>
								<version>${error-prone.version}</version>
							</path>
							<path>
								<groupId>com.uber.nullaway</groupId>
								<artifactId>nullaway</artifactId>
								<version>${nullaway.version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>${maven-jar-plugin.version}</version>
					<configuration>
						<archive>
							<manifestEntries>
								<Implementation-Title>${project.artifactId}</Implementation-Title>
								<Implementation-Version>${project.version}</Implementation-Version>
							</manifestEntries>
						</archive>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<version>${maven-source-plugin.version}</version>
					<executions>
						<execution>
							<id>attach-sources</id>
							<goals>
								<goal>jar-no-fork</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<version>${maven-javadoc-plugin.version}</version>
					<configuration>
						<doclint>none</doclint>
						<failOnError>false</failOnError>
						<quiet>true</quiet>
					</configuration>
					<executions>
						<execution>
							<id>attach-javadocs</id>
							<goals>
								<goal>jar</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-resources-plugin</artifactId>
					<version>${maven-resources-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>${maven-surefire-plugin.version}</version>
					<configuration>
						<includes>
							<include>**/*Spec.*</include>
							<include>**/*Tests.*</include>
							<include>**/*Test.*</include>
						</includes>
						<reportFormat>plain</reportFormat>
						<failIfNoTests>true</failIfNoTests>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-failsafe-plugin</artifactId>
					<version>${maven-failsafe-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-deploy-plugin</artifactId>
					<version>${maven-deploy-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-install-plugin</artifactId>
					<version>${maven-install-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-clean-plugin</artifactId>
					<version>${maven-clean-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-antrun-plugin</artifactId>
					<version>${maven-antrun-plugin.version}</version>
				</plugin>
				<!--
				  POM flattening: expands parent refs and removes CI-unfriendly elements
				  before publishing. Mode 'oss' is the standard for open-source Maven Central
				  artifacts — it expands parent and removes internal-only elements.
				-->
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>flatten-maven-plugin</artifactId>
					<version>${flatten-maven-plugin.version}</version>
					<inherited>true</inherited>
					<configuration>
						<updatePomFile>true</updatePomFile>
						<flattenMode>oss</flattenMode>
						<pomElements>
							<parent>expand</parent>
							<distributionManagement>remove</distributionManagement>
							<repositories>remove</repositories>
						</pomElements>
					</configuration>
					<executions>
						<execution>
							<id>flatten</id>
							<phase>process-resources</phase>
							<goals>
								<goal>flatten</goal>
							</goals>
						</execution>
						<execution>
							<id>flatten-clean</id>
							<phase>clean</phase>
							<goals>
								<goal>clean</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.codehaus.gmavenplus</groupId>
					<artifactId>gmavenplus-plugin</artifactId>
					<version>${gmavenplus-plugin.version}</version>
					<executions>
						<execution>
							<goals>
								<goal>addSources</goal>
								<goal>addTestSources</goal>
								<goal>compile</goal>
								<goal>compileTests</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.sonatype.central</groupId>
					<artifactId>central-publishing-maven-plugin</artifactId>
					<version>${central-publishing-maven-plugin.version}</version>
					<extensions>true</extensions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-gpg-plugin</artifactId>
					<version>${maven-gpg-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>exec-maven-plugin</artifactId>
					<version>${exec-maven-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco-maven-plugin.version}</version>
					<configuration>
						<haltOnFailure>${jacoco.haltOnFailure}</haltOnFailure>
						<!--
						  The coverage gate measures unit AND integration tests. The Kafka/Rabbit
						  *ConformanceTests (@Testcontainers) run in the coverage job (Docker is
						  available on the CI runner) and, being surefire tests, their coverage is
						  captured by the jacoco agent - so the broker-I/O sender/receiver classes are
						  counted normally and need no exclusion.
						
						  Only stub-runner git / Maven-resolver / filesystem-IO error paths remain
						  excluded: their SSH transport, Aether ServiceLocator reflection and
						  delete/retry IO-failure branches are exercised by neither a unit nor an
						  integration test here (they need a real git remote, a real Maven repository
						  or a failing filesystem). Tracked for follow-up integration tests.
						-->
						<excludes>
							<!--
							  Rabbit broker-connection classes: the RabbitMessageVerifierConformanceTests
							  round-trip (Testcontainers) covers the happy send/receive path and IS counted,
							  but the connection-open / receive-timeout / error branches in the sender,
							  receiver and abstract verifier are not reached without a controllable broker
							  failure, leaving the bundle at ~72%. Excluded until a broker-failure integration
							  test lands (follow-up). Kafka reaches the floor via its conformance round-trip
							  and is NOT excluded. RabbitMessage (the adapter) stays counted.
							-->
							<exclude>sh/stubborn/messaging/rabbit/StubbornRabbitMessageVerifierSender.class</exclude>
							<exclude>sh/stubborn/messaging/rabbit/StubbornRabbitMessageVerifierReceiver.class</exclude>
							<exclude>sh/stubborn/messaging/rabbit/AbstractStubbornRabbitVerifier.class</exclude>
							<exclude>sh/stubborn/contract/stubrunner/GitRepo.class</exclude>
							<exclude>sh/stubborn/contract/stubrunner/GitRepo$*.class</exclude>
							<exclude>sh/stubborn/contract/stubrunner/GitStubDownloader.class</exclude>
							<exclude>sh/stubborn/contract/stubrunner/AetherStubDownloader.class</exclude>
							<exclude>sh/stubborn/contract/stubrunner/AetherStubDownloaderBuilder.class</exclude>
							<exclude>sh/stubborn/contract/stubrunner/AetherFactories.class</exclude>
							<exclude>sh/stubborn/contract/stubrunner/AetherFactories$*.class</exclude>
							<exclude>sh/stubborn/contract/stubrunner/DirectoryCopyingVisitor.class</exclude>
							<exclude>sh/stubborn/contract/stubrunner/DirectoryCopyingVisitor$*.class</exclude>
						</excludes>
					</configuration>
					<executions>
						<!--
						  Coverage gate. Only runs when a jacoco plugin declaration is active
						  (the -Psonar profile in the root pom, or the CI coverage job) since
						  pluginManagement executions do not activate the plugin on their own.
						  Bound to verify; -Psonar binds prepare-agent + report at test, so a
						  full verify/install run with -Psonar produces data then checks it.
						-->
						<execution>
							<id>jacoco-check</id>
							<phase>verify</phase>
							<goals>
								<goal>check</goal>
							</goals>
							<configuration>
								<rules>
									<rule>
										<element>BUNDLE</element>
										<limits>
											<limit>
												<counter>LINE</counter>
												<value>COVEREDRATIO</value>
												<minimum>${jacoco.line.min}</minimum>
											</limit>
											<limit>
												<counter>BRANCH</counter>
												<value>COVEREDRATIO</value>
												<minimum>${jacoco.branch.min}</minimum>
											</limit>
										</limits>
									</rule>
								</rules>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<!--
				  PIT mutation testing. Managed here; each of the 12 core gate modules
				  declares the plugin (no version/config) to inherit this. targetClasses /
				  targetTests are intentionally NOT set so PIT defaults to the module's own
				  ${project.groupId}.* (sh.stubborn.*) per module. Invoked via
				  org.pitest:pitest-maven:mutationCoverage (see docs/quality-gates.md and the
				  mutation-diff CI job).
				-->
				<plugin>
					<groupId>org.pitest</groupId>
					<artifactId>pitest-maven</artifactId>
					<version>${pitest-maven.version}</version>
					<dependencies>
						<dependency>
							<groupId>org.pitest</groupId>
							<artifactId>pitest-junit5-plugin</artifactId>
							<version>${pitest-junit5-plugin.version}</version>
						</dependency>
					</dependencies>
					<configuration>
						<outputFormats>
							<param>HTML</param>
							<param>CSV</param>
						</outputFormats>
						<timestampedReports>false</timestampedReports>
						<failWhenNoMutations>false</failWhenNoMutations>
						<mutationThreshold>${pitest.mutationThreshold}</mutationThreshold>
						<coverageThreshold>0</coverageThreshold>
						<!-- ArchUnit boundary tests (NoSpringArchTests, NoGroovyArchTests, ...) verify
						     architecture, not behaviour: they kill no mutants and their whole-classpath
						     scan does not survive PIT's isolated harness ("did not pass without mutation").
						     Exclude them from mutation runs. -->
						<excludedTestClasses>
							<param>*ArchTests</param>
							<param>*ArchTest</param>
							<!-- Integration tests are not mutation-tested: the *ConformanceTests
							     (@Testcontainers) exist to verify real-broker behaviour, count toward
							     line/branch coverage, but must not run inside PIT (slow, Docker-bound,
							     and mutation of broker-I/O is out of scope). -->
							<param>*ConformanceTests</param>
						</excludedTestClasses>
						<!-- DEFAULTS minus VOID_METHOD_CALLS: the only surviving void-call mutations here
						     are removals of logging/trace side-effect calls (logOverridingWarning),
						     equivalent by construction. All other DEFAULTS mutators are kept. -->
						<mutators>
							<mutator>CONDITIONALS_BOUNDARY</mutator>
							<mutator>INCREMENTS</mutator>
							<mutator>INVERT_NEGS</mutator>
							<mutator>MATH</mutator>
							<mutator>NEGATE_CONDITIONALS</mutator>
							<mutator>EMPTY_RETURNS</mutator>
							<mutator>FALSE_RETURNS</mutator>
							<mutator>TRUE_RETURNS</mutator>
							<mutator>NULL_RETURNS</mutator>
							<mutator>PRIMITIVE_RETURNS</mutator>
						</mutators>
					</configuration>
				</plugin>
				<plugin>
					<groupId>io.spring.javaformat</groupId>
					<artifactId>spring-javaformat-maven-plugin</artifactId>
					<version>${spring-javaformat.version}</version>
					<executions>
						<execution>
							<phase>validate</phase>
							<inherited>true</inherited>
							<goals>
								<goal>validate</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-checkstyle-plugin</artifactId>
					<version>${maven-checkstyle-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>build-helper-maven-plugin</artifactId>
					<version>${build-helper-maven-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>com.github.spotbugs</groupId>
					<artifactId>spotbugs-maven-plugin</artifactId>
					<version>${spotbugs-maven-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.owasp</groupId>
					<artifactId>dependency-check-maven</artifactId>
					<version>${dependency-check-maven.version}</version>
					<configuration>
						<failBuildOnCVSS>7</failBuildOnCVSS>
						<nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
						<!--
						  Sonatype OSS Index now requires authentication: without credentials the
						  analyzer returns HTTP 401 Unauthorized and throws an AnalysisException that
						  fails modules independently of any CVE. Disable it so the NVD (the
						  authoritative source, gated by failBuildOnCVSS above) is the single source
						  of truth for this scan.
						-->
						<ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
						<!--
						  Suppress CVEs that have no pinnable GA fix yet (currently CVE-2026-53914:
						  Kotlin build-time/DSL tooling whose fix, Kotlin 2.4.20, is not on Maven
						  Central as GA). See config/dependency-check-suppressions.xml for the full
						  justification and removal condition. Path is anchored to the reactor root so
						  it resolves the same for every module.
						-->
						<suppressionFiles>
							<suppressionFile>${maven.multiModuleProjectDirectory}/config/dependency-check-suppressions.xml</suppressionFile>
						</suppressionFiles>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.jetbrains.kotlin</groupId>
					<artifactId>kotlin-maven-plugin</artifactId>
					<version>${kotlin-maven-plugin.version}</version>
				</plugin>
	<plugin>
					<groupId>org.jetbrains.dokka</groupId>
					<artifactId>dokka-maven-plugin</artifactId>
					<version>2.1.0</version>
					<configuration>
						<skip>true</skip>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.revapi</groupId>
					<artifactId>revapi-maven-plugin</artifactId>
					<version>${revapi-maven-plugin.version}</version>
					<dependencies>
						<dependency>
							<groupId>org.revapi</groupId>
							<artifactId>revapi-java</artifactId>
							<version>${revapi-java.version}</version>
						</dependency>
					</dependencies>
					<configuration>
						<skip>${stubborn.revapi.skip}</skip>
						<analysisConfiguration>
							<revapi.java>
								<filter>
									<packages>
										<regex>true</regex>
										<include>
											<item>sh\.stubborn\..*</item>
										</include>
									</packages>
								</filter>
							</revapi.java>
							<revapi.differences>
								<ignore>true</ignore>
								<differences>
									<!-- Intentional API changes must be acknowledged here with a justification. -->
								</differences>
							</revapi.differences>
						</analysisConfiguration>
					</configuration>
					<executions>
						<execution>
							<id>check-compatibility</id>
							<goals>
								<goal>check</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<!--
			  Flatten POMs so published artifacts don't have unresolved ${revision} refs
			  or internal parent chains. Activating here makes it apply to all modules.
			-->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
			</plugin>
			<!--
			  Activated in Spring-agnostic core modules by setting:
			    <stubborn.no-spring.skip>false</stubborn.no-spring.skip>
			  Bans direct Spring compile-scope dependencies so the core layer stays
			  framework-free. Test-scope Spring is allowed.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>${maven-enforcer-plugin.version}</version>
				<executions>
					<execution>
						<id>ban-spring-in-core</id>
						<phase>validate</phase>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<skip>${stubborn.no-spring.skip}</skip>
							<rules>
								<bannedDependencies>
									<searchTransitive>false</searchTransitive>
									<excludes>
										<exclude>org.springframework:*</exclude>
										<exclude>org.springframework.boot:*</exclude>
										<exclude>org.springframework.cloud:*</exclude>
									</excludes>
									<includes>
										<!-- Spring is acceptable in test scope for core modules -->
										<include>org.springframework:*:*:*:test</include>
										<include>org.springframework.boot:*:*:*:test</include>
										<include>org.springframework.cloud:*:*:*:test</include>
									</includes>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
						<!--
						  Repo-wide guardrail: Stubborn Contract is the successor to Spring
						  Cloud Contract and must not depend on the old SCC API in ANY module
						  or scope. Bans org.springframework.cloud:spring-cloud-contract*
						  (verifier, spec, stub-runner, wiremock, the -dependencies BOM, ...)
						  directly and transitively, so a "migrated" reactor can never drag
						  the old stack back onto a classpath. Runs in every module: the
						  spring-cloud-* stream/discovery deps in the -spring-cloud tier are
						  fine, only spring-cloud-contract* is banned. Escape hatch: set
						  stubborn.no-scc.skip=true in a module that genuinely must keep it
						  (e.g. a dedicated SCC-compatibility test). See
						  stubborn-sh/stubborn-openapi#22.
						-->
						<execution>
							<id>ban-scc-api</id>
							<phase>validate</phase>
							<goals>
								<goal>enforce</goal>
							</goals>
							<configuration>
								<skip>${stubborn.no-scc.skip}</skip>
								<rules>
									<bannedDependencies>
										<searchTransitive>true</searchTransitive>
										<excludes>
											<exclude>org.springframework.cloud:spring-cloud-contract*</exclude>
										</excludes>
									</bannedDependencies>
								</rules>
							</configuration>
						</execution>
				</executions>
			</plugin>
			<!--
			  Bans Groovy production source (src/main/**/*.groovy) so production code
			  stays Java-only. Contract fixtures under src/main/resources are ignored
			  (only source roots src/main/java and src/main/groovy are scanned).
			  Modules that legitimately ship a Groovy DSL opt out with:
			    <stubborn.no-groovy.skip>true</stubborn.no-groovy.skip>
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<execution>
						<id>ban-groovy-in-production</id>
						<phase>validate</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<skip>${stubborn.no-groovy.skip}</skip>
							<target>
								<pathconvert property="stubborn.groovy.production.sources" setonempty="false">
									<fileset dir="${project.basedir}" erroronmissingdir="false">
										<include name="src/main/java/**/*.groovy"/>
										<include name="src/main/groovy/**/*.groovy"/>
									</fileset>
								</pathconvert>
								<fail if="stubborn.groovy.production.sources">
Groovy source is not allowed in production code (src/main). Convert it to Java, or set stubborn.no-groovy.skip=true in a module that ships a Groovy DSL.
Offending files:
${stubborn.groovy.production.sources}
								</fail>
							</target>
						</configuration>
					</execution>
					<!--
					  Bans groovy.transform.* imports (e.g. @CompileStatic) in Java main
					  sources. Those annotations only affect the Groovy compiler and are
					  no-ops on Java files, so they add needless Groovy coupling. Opt-in
					  per module by setting stubborn.no-groovy-transform.skip=false.
					-->
					<execution>
						<id>ban-groovy-transform-in-production</id>
						<phase>validate</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<skip>${stubborn.no-groovy-transform.skip}</skip>
							<target>
								<pathconvert property="stubborn.groovy.transform.imports" setonempty="false">
									<fileset dir="${project.basedir}" erroronmissingdir="false">
										<include name="src/main/java/**/*.java"/>
										<containsregexp expression="import\s+groovy\.transform\."/>
									</fileset>
								</pathconvert>
								<fail if="stubborn.groovy.transform.imports">
groovy.transform.* imports are not allowed in Java production code (src/main/java). They only affect the Groovy compiler and are no-ops on Java sources.
Offending files:
${stubborn.groovy.transform.imports}
								</fail>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
		<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<dependencies>
					<dependency>
						<groupId>io.spring.javaformat</groupId>
						<artifactId>spring-javaformat-checkstyle</artifactId>
						<version>${spring-javaformat.version}</version>
					</dependency>
					<dependency>
						<groupId>com.puppycrawl.tools</groupId>
						<artifactId>checkstyle</artifactId>
						<version>13.9.0</version>
					</dependency>
				</dependencies>
				<configuration>
					<configLocation>io/spring/javaformat/checkstyle/checkstyle.xml</configLocation>
					<suppressionsLocation>${maven.multiModuleProjectDirectory}/src/checkstyle/checkstyle-suppressions.xml</suppressionsLocation>
					<includeTestSourceDirectory>true</includeTestSourceDirectory>
					<excludes>**/generated-sources/**/*,**/contractsToCompile/**/*,**/groovy-stubs/**/*</excludes>
				</configuration>
				<executions>
					<execution>
						<id>checkstyle-validation</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
					<!--
					  Public-API Javadoc policy: every public type must have a Javadoc
					  comment carrying an @since tag. Runs on main sources only (the
					  spring config above also lints test sources, which must not be
					  held to the public-API @since rule).
					-->
					<execution>
						<id>checkstyle-public-api-javadoc</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<configLocation>${maven.multiModuleProjectDirectory}/src/checkstyle/checkstyle-public-api.xml</configLocation>
							<includeTestSourceDirectory>false</includeTestSourceDirectory>
							<!-- Own cache file so it never collides with the main checkstyle execution. -->
							<cacheFile>${project.build.directory}/checkstyle-public-api-cachefile</cacheFile>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<configuration>
					<effort>Max</effort>
					<threshold>Medium</threshold>
					<excludeFilterFile>${maven.multiModuleProjectDirectory}/src/spotbugs/spotbugs-exclude.xml</excludeFilterFile>
					<plugins>
						<plugin>
							<groupId>com.h3xstream.findsecbugs</groupId>
							<artifactId>findsecbugs-plugin</artifactId>
							<version>${findsecbugs-plugin.version}</version>
						</plugin>
					</plugins>
				</configuration>
				<executions>
					<execution>
						<id>spotbugs-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
		  Snapshot + release publishing to Maven Central Portal.

		  Usage:
		    Snapshots: ./mvnw deploy -Ppublish -DskipTests
		    Releases:  ./mvnw deploy -Ppublish,release -DskipTests
		-->
		<profile>
			<id>publish</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<deploymentName>${project.artifactId}-${project.version}</deploymentName>
							<autoPublish>${central.autoPublish}</autoPublish>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- GPG signing — combine with 'publish' profile for releases -->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<!--
					  CycloneDX SBOM: attach a Software Bill of Materials to every published
					  artifact. makeBom runs at 'package' (before the GPG 'sign' at 'verify'),
					  so the SBOM (…-cyclonedx.json) is attached, signed, and deployed to Maven
					  Central alongside the JAR. Only active for release/publish builds so normal
					  PR/dev builds are unaffected.
					-->
					<plugin>
						<groupId>org.cyclonedx</groupId>
						<artifactId>cyclonedx-maven-plugin</artifactId>
						<version>${cyclonedx-maven-plugin.version}</version>
						<executions>
							<execution>
								<id>make-sbom</id>
								<phase>package</phase>
								<goals>
									<goal>makeBom</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<projectType>library</projectType>
							<outputFormat>json</outputFormat>
							<skipNotDeployed>true</skipNotDeployed>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<gpgArguments>
								<arg>--pinentry-mode</arg>
								<arg>loopback</arg>
							</gpgArguments>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
