<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>sh.stubborn</groupId>
		<artifactId>stubborn-contract-parent</artifactId>
		<version>0.1.1-SNAPSHOT</version>
		<relativePath>..</relativePath>
	</parent>

	<artifactId>stubborn-contract-migration</artifactId>
	<packaging>jar</packaging>
	<name>Stubborn Contract Migration</name>
	<description>OpenRewrite recipes to migrate from Spring Cloud Contract to Stubborn Contract</description>

	<properties>
		<!-- Both aligned by org.openrewrite.recipe:rewrite-recipe-bom:3.37.0; bump them together. -->
		<openrewrite.version>8.89.0</openrewrite.version>
		<openrewrite-java-dependencies.version>1.60.2</openrewrite-java-dependencies.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.openrewrite</groupId>
			<artifactId>rewrite-java</artifactId>
			<version>${openrewrite.version}</version>
		</dependency>
		<!--
		  rewrite-java-dependencies supplies org.openrewrite.java.dependencies.ChangeDependency,
		  which delegates to the Maven and Gradle coordinate recipes. UpdateDependencies lists each
		  coordinate once through it instead of once per build tool.
		-->
		<dependency>
			<groupId>org.openrewrite.recipe</groupId>
			<artifactId>rewrite-java-dependencies</artifactId>
			<version>${openrewrite-java-dependencies.version}</version>
		</dependency>
		<dependency>
			<groupId>org.openrewrite</groupId>
			<artifactId>rewrite-maven</artifactId>
			<version>${openrewrite.version}</version>
		</dependency>
		<!--
		  rewrite-gradle is kept for the planned Gradle build-script migration recipes
		  (org.openrewrite.gradle.*), even though migrate-from-scc is currently Maven/Java only.
		  It transitively pulls rewrite-kotlin + the Kotlin runtime (2.3.21), which is exposed to
		  CVE-2026-53914 (CVSS 9.8). No GA fix (Kotlin 2.4.20) is on Maven Central yet, so rather
		  than pin a pre-release, the CVE is suppressed centrally for all org.jetbrains.kotlin
		  coordinates in config/dependency-check-suppressions.xml (documented, removal-on-GA).
		-->
		<dependency>
			<groupId>org.openrewrite</groupId>
			<artifactId>rewrite-gradle</artifactId>
			<version>${openrewrite.version}</version>
		</dependency>
		<!-- rewrite-properties + rewrite-yaml back the Stub Runner property-key migration
		     (org.openrewrite.{properties,yaml}.ChangePropertyKey) in application.properties/yml. -->
		<dependency>
			<groupId>org.openrewrite</groupId>
			<artifactId>rewrite-properties</artifactId>
			<version>${openrewrite.version}</version>
		</dependency>
		<dependency>
			<groupId>org.openrewrite</groupId>
			<artifactId>rewrite-yaml</artifactId>
			<version>${openrewrite.version}</version>
		</dependency>
		<!-- test -->
		<dependency>
			<groupId>org.openrewrite</groupId>
			<artifactId>rewrite-test</artifactId>
			<version>${openrewrite.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.openrewrite</groupId>
			<artifactId>rewrite-java-17</artifactId>
			<version>${openrewrite.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.openrewrite</groupId>
			<artifactId>rewrite-java-21</artifactId>
			<version>${openrewrite.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
