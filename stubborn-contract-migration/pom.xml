<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>sh.stubborn</groupId>
		<artifactId>stubborn-contract-parent</artifactId>
		<version>0.1.3-SNAPSHOT</version>
		<relativePath>..</relativePath>
	</parent>

	<artifactId>stubborn-contract-migration</artifactId>
	<packaging>jar</packaging>
	<name>Stubborn Contract Migration</name>
	<description>OpenRewrite recipes to migrate from Spring Cloud Contract to Stubborn Contract</description>

	<properties>
		<openrewrite-bom.version>8.90.4</openrewrite-bom.version>
		<openrewrite-recipe-bom.version>3.37.0</openrewrite-recipe-bom.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Remove once a release of rewrite-recipe-bom carries rewrite 8.90.3 or later. -->
			<dependency>
				<groupId>org.openrewrite</groupId>
				<artifactId>rewrite-bom</artifactId>
				<version>${openrewrite-bom.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- Supplies the org.openrewrite.recipe module versions; the import above wins the core ones. -->
			<dependency>
				<groupId>org.openrewrite.recipe</groupId>
				<artifactId>rewrite-recipe-bom</artifactId>
				<version>${openrewrite-recipe-bom.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.openrewrite</groupId>
			<artifactId>rewrite-java</artifactId>
		</dependency>
		<!-- Supplies ChangeDependency, so UpdateDependencies lists each coordinate once for both build tools. -->
		<dependency>
			<groupId>org.openrewrite.recipe</groupId>
			<artifactId>rewrite-java-dependencies</artifactId>
		</dependency>
		<dependency>
			<groupId>org.openrewrite</groupId>
			<artifactId>rewrite-properties</artifactId>
		</dependency>
		<dependency>
			<groupId>org.openrewrite</groupId>
			<artifactId>rewrite-yaml</artifactId>
		</dependency>
		<!-- test -->
		<dependency>
			<groupId>org.openrewrite</groupId>
			<artifactId>rewrite-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Matches the JDK the build runs on (java.version=17, and every workflow sets 17). -->
		<dependency>
			<groupId>org.openrewrite</groupId>
			<artifactId>rewrite-java-17</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
